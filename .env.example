# App runtime — point at the PgBouncer endpoint (transaction mode) in prod.
DATABASE_URL=postgres://127.0.0.1/your-database-name
# Direct Postgres port for `payload migrate`/drizzle-kit when DATABASE_URL
# points at a transaction-mode pooler (skip if connecting directly).
# DIRECT_DATABASE_URL=postgres://127.0.0.1:5432/your-database-name
# Pool tuning (see payload.config.ts). max applies per serverless isolate —
# keep it low; the pooler multiplexes onto the real server connections.
# DB_POOL_MAX=5
# DB_APP_NAME=kitakits-app
# DB_QUERY_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL (used for email links, e.g. password reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Kitakits

# Media storage (UploadThing)
UPLOADTHING_TOKEN=YOUR_UPLOADTHING_TOKEN

# Video streaming (Bunny Stream)
# BUNNY_STREAM_HOSTNAME is the stream pull zone, e.g. https://vz-abc123.b-cdn.net
BUNNY_STREAM_LIBRARY_ID=YOUR_LIBRARY_ID
BUNNY_STREAM_API_KEY=YOUR_STREAM_API_KEY
BUNNY_STREAM_HOSTNAME=https://vz-XXXXX.b-cdn.net
# Shared secret for the encode webhook:
# set the library webhook URL to https://<app>/api/bunny-webhook?secret=<this value>
BUNNY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Live push (chat-server) — the app relays live events (nav badges, new feed
# posts, video status) to connected clients through the WebSocket service.
# NEXT_PUBLIC_CHAT_WS_URL is the BROWSER-facing wss:// URL; CHAT_EMIT_URL is
# the chat server's INTERNAL /emit address; LIVE_EMIT_SECRET must match the
# value set on the chat-server service.
# NEXT_PUBLIC_CHAT_WS_URL=wss://ws.example.com
# CHAT_EMIT_URL=http://localhost:3001/emit
# LIVE_EMIT_SECRET=YOUR_EMIT_SECRET

# Videoke song search (YouTube Data API v3). Without a key the Videoke app
# still works but members can't search/queue songs.
# YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
# Channel handle whose videos are searchable (default @AtomicKaraoke):
# YOUTUBE_KARAOKE_CHANNEL=@AtomicKaraoke
# Required when the API key is HTTP-referrer restricted (a "browser" key) —
# set it to an allowed referer so server-side calls pass:
# YOUTUBE_API_REFERER=http://localhost:3000

# Videoke voice (self-hosted LiveKit SFU — see deploy/livekit/). The key pair
# must match the SFU's LIVEKIT_KEYS; NEXT_PUBLIC_LIVEKIT_URL is the browser-
# facing wss:// address of the :7880 endpoint. Without these the room mic
# stays a local level meter and no voice traffic flows.
# LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
# LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
# NEXT_PUBLIC_LIVEKIT_URL=wss://voice.example.com

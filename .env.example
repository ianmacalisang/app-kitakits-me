# App runtime — point at the PgBouncer endpoint (transaction mode) in prod.
DATABASE_URL=postgres://127.0.0.1/your-database-name
# Direct Postgres port for `payload migrate`/drizzle-kit when DATABASE_URL
# points at a transaction-mode pooler (skip if connecting directly).
# DIRECT_DATABASE_URL=postgres://127.0.0.1:5432/your-database-name
# Pool tuning (see payload.config.ts). max applies per serverless isolate —
# keep it low; the pooler multiplexes onto the real server connections.
# DB_POOL_MAX=5
# DB_APP_NAME=kitakits-app
# DB_QUERY_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL (used for email links, e.g. password reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Kitakits

# Media storage (UploadThing)
UPLOADTHING_TOKEN=YOUR_UPLOADTHING_TOKEN

# Video streaming (Bunny Stream)
# BUNNY_STREAM_HOSTNAME is the stream pull zone, e.g. https://vz-abc123.b-cdn.net
BUNNY_STREAM_LIBRARY_ID=YOUR_LIBRARY_ID
BUNNY_STREAM_API_KEY=YOUR_STREAM_API_KEY
BUNNY_STREAM_HOSTNAME=https://vz-XXXXX.b-cdn.net
# Shared secret for the encode webhook:
# set the library webhook URL to https://<app>/api/bunny-webhook?secret=<this value>
BUNNY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
